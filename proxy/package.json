{
  "name": "campon-ai-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/*.js",
  "scripts": {
    "test": "node --test",
    "build": "esbuild api/plan.ts api/preview.ts api/campsite-image.ts api/campsite-reservation.ts api/warmup.ts --bundle --platform=node --format=esm --outdir=dist --external:@azure/functions",
    "build:oracle": "esbuild api/server.ts --bundle --platform=node --format=esm --outdir=dist",
    "start": "npm run build && func start",
    "start:oracle": "node dist/server.js",
    "verify:naver": "node --env-file-if-exists=.env scripts/verify_naver_image.mjs"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
